new file mode 100644
index 0000000000000000000000000000000000000000..76fdae3b682c8035e8e677e4b691de7eb845134c
--- /dev/null
+++ b/src/main/java/io/papermc/paper/compat/CompatManager.java
@@ -0,0 +1,75 @@
+package io.papermc.paper.compat;
+
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.AtomicReference;
+
+/**
+ * Minimal compatibility manager that provides a single-threaded executor to emulate the "main"/plugin thread
+ * for legacy Bukkit/Spigot/Paper plugins when Folia multithreading is in use.
+ *
+ * Controlled via system property: -Dpaper.folia.plugin-compat=true|false (default: true)
+ */
+public final class CompatManager {
+    private static final CompatManager INSTANCE = new CompatManager();
+
+    private final boolean enabled;
+    private final ExecutorService executor;
+    private final AtomicReference<Thread> compatThread = new AtomicReference<>();
+
+    private CompatManager() {
+        this.enabled = Boolean.parseBoolean(System.getProperty("paper.folia.plugin-compat", "true"));
+        if (this.enabled) {
+            ThreadFactory tf = r -> {
+                Thread t = new Thread(r, "Paper-PluginCompat");
+                t.setDaemon(true);
+                compatThread.set(t);
+                return t;
+            };
+            this.executor = Executors.newSingleThreadExecutor(tf);
+        } else {
+            this.executor = null;
+        }
+    }
+
+    public static CompatManager instance() {
+        return INSTANCE;
+    }
+
+    public boolean isEnabled() {
+        return enabled;
+    }
+
+    public boolean isCompatThread() {
+        Thread t = compatThread.get();
+        return t != null && Thread.currentThread() == t;
+    }
+
+    public Future<?> submit(Runnable r) {
+        if (!enabled) {
+            throw new IllegalStateException("CompatManager disabled");
+        }
+        return executor.submit(r);
+    }
+
+    public void submitAndWait(Runnable r) {
+        Future<?> f = submit(r);
+        try {
+            f.get();
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            throw new RuntimeException(e);
+        } catch (ExecutionException e) {
+            // Unwrap
+            Throwable cause = e.getCause();
+            if (cause instanceof RuntimeException) throw (RuntimeException) cause;
+            throw new RuntimeException(cause);
+        }
+    }
+
+    public void shutdownNow() {
+        if (executor != null) {
+            executor.shutdownNow();
+        }
+    }
+}
+

+    // Extract original handle logic to a private method so we can route through compat when required
+    private CraftTask handleOriginal(final CraftTask task, final long delay) {
+        // Paper start
+        if (!this.isAsyncScheduler && !task.isSync()) {
+            this.asyncScheduler.handle(task, delay);
+            return task;
+        }
+        // Paper end
+        task.setNextRun(this.currentTick + delay);
+        this.addTask(task);
+        return task;
+    }
+
+    protected CraftTask handle(final CraftTask task, final long delay) { // Paper
+        // Paper start
+        // If compat is enabled and this is a sync task, ensure scheduling happens on the compat thread.
+        if (task.isSync() && CompatManager.instance().isEnabled()) {
+            if (!CompatManager.instance().isCompatThread()) {
+                CompatManager.instance().submitAndWait(() -> {
+                    // perform original handle logic on compat thread
+                    if (!this.isAsyncScheduler && !task.isSync()) {
+                        this.asyncScheduler.handle(task, delay);
+                        return;
+                    }
+                    task.setNextRun(this.currentTick + delay);
+                    this.addTask(task);
+                });
+                return task;
+            }
+        }
+        // Default/orig behavior
+        if (!this.isAsyncScheduler && !task.isSync()) {
+            this.asyncScheduler.handle(task, delay);
+            return task;
+        }
+        task.setNextRun(this.currentTick + delay);
+        this.addTask(task);
+        return task;
+        // Paper end
+    }
+
